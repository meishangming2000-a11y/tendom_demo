<mujoco model="shadow_arm_combo_stage1">
  <include file="../printed_arm_stage1/robot.xml"/>
  <include file="shadow_right_hand_mountable.xml"/>

  <statistic extent="0.9" center="0 0 0.08"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="8192"/>
    <global azimuth="205" elevation="-22" offwidth="1280" offheight="900"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="combo_groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="combo_groundplane" texture="combo_groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light name="combo_fill_light" pos="0 0 1"/>
    <light name="combo_key_light" pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="combo_floor" pos="0 0 -0.1" size="0 0 0.05" type="plane" material="combo_groundplane" contype="0" conaffinity="4"/>
    <body name="combo_object" pos="0.3 0 0.1">
      <freejoint/>
      <geom name="combo_object_geom" type="sphere" size="0.03" rgba="0.5 0.7 0.5 1" condim="3" priority="1"
        friction="0.5 0.01 0.003" contype="7"/>
    </body>
    <camera name="combo_overview" pos="0.05 -1.05 0.36"
      xyaxes="0.999955 0.00952338 0 -0.00245371 0.25764 0.966238" fovy="55"/>
    <camera name="combo_top" pos="0.05 -0.05 1.10" xyaxes="1 0 0 0 0.999628 0.0272626" fovy="55"/>
  </worldbody>

  <equality>
    <!-- Stage 1 wrapper mount: keep Shadow source files untouched and constrain the root body to the printed-arm ee mount. -->
    <weld name="combo_shadow_mount_weld" body1="pa_ee_mount" body2="rh_forearm"/>
  </equality>

  <actuator>
    <!-- Stage 1 wrapper-side wrist lock. These keep the Shadow wrist near zero without editing the source Shadow XML. -->
    <position name="combo_lock_rh_WRJ1" joint="rh_WRJ1" kp="150" ctrlrange="0 0" forcerange="-40 40"/>
    <position name="combo_lock_rh_WRJ2" joint="rh_WRJ2" kp="150" ctrlrange="0 0" forcerange="-40 40"/>
  </actuator>
</mujoco>
